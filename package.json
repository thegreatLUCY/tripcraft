{
  "name": "travel-planner",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build:web": "npm run build --workspace=apps/web",
    "type-check": "npm run type-check --workspace=apps/web && npm run type-check --workspace=apps/mobile"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
